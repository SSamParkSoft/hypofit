{
  "name": "hypofit",
  "private": true,
  "version": "1.0.1",
  "description": "초기 창업팀과 실제 타깃 고객을 연결하는 인터뷰 매칭 서비스",
  "license": "MIT",
  "homepage": "https://hypofit.bukae.co.kr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSamParkSoft/hypofit.git"
  },
  "bugs": {
    "url": "https://github.com/SSamParkSoft/hypofit/issues"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "build:web": "pnpm --dir apps/web build",
    "brand:export": "pnpm --dir apps/web brand:export",
    "lint:web": "pnpm --dir apps/web lint",
    "test:web": "pnpm --dir apps/web test",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "ios:mobile": "pnpm --dir apps/mobile ios",
    "android:mobile": "pnpm --dir apps/mobile android",
    "typecheck:mobile": "pnpm --dir apps/mobile typecheck",
    "build:mobile:ios:local": "corepack pnpm --dir apps/mobile build:ios:local"
  }
}
