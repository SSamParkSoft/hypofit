# Shared
ENV=local

# Web
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me
VITE_SUPPORT_EMAIL=ssamso8282@gmail.com
PUBLIC_WEB_BASE_URL=https://hypofit.bukae.co.kr
SUPPORT_EMAIL=ssamso8282@gmail.com
RESEND_API_KEY=replace_me_for_public_account_deletion_email
RESEND_FROM_EMAIL=Hypofit <support@hypofit.bukae.co.kr>
VITE_USE_MOCK_DATA=false
VITE_KAKAO_MAP_APP_KEY=replace_me

# Mobile
# iOS simulator can use http://127.0.0.1:8080. Android emulator can use http://10.0.2.2:8080.
# Real devices and EAS builds need a reachable HTTPS API URL.
EXPO_PUBLIC_API_BASE_URL=https://hypofit-api.bukae.co.kr
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace_me
EXPO_PUBLIC_SUPPORT_EMAIL=ssamso8282@gmail.com
EXPO_PUBLIC_WEB_BASE_URL=https://hypofit.bukae.co.kr
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_me_for_android_or_google_ios_maps
# Android native push build config. Keep the JSON file out of git.
HYPOFIT_ANDROID_VERSION_CODE=1
GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json

# API
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hypofit
SUPABASE_URL=https://xxxxx.supabase.co
# Backend/server-only. Required only for demo seeding scripts; never expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace_me
ACCOUNT_DELETION_HASH_PEPPER=replace_me_with_random_server_secret
SOCIAL_AUTH_ENABLED=false
# Legacy Apple state used when a platform-specific override is blank.
SOCIAL_AUTH_APPLE_STATE=disabled
SOCIAL_AUTH_APPLE_IOS_STATE=
SOCIAL_AUTH_APPLE_WEB_STATE=
SOCIAL_AUTH_GOOGLE_STATE=disabled
SOCIAL_AUTH_KAKAO_STATE=disabled
SOCIAL_AUTH_NAVER_STATE=disabled
SOCIAL_AUTH_ATTEMPT_TTL_SECONDS=600
SOCIAL_AUTH_ATTEMPT_PEPPER=replace_me_with_random_server_secret
SOCIAL_AUTH_IDENTITY_PEPPER=replace_me_with_different_random_server_secret
APPLE_SIGN_IN_APP_ID=com.contentruck.hypofit
APPLE_SIGN_IN_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_SIGN_IN_JWKS_CACHE_SECONDS=3600
SUPABASE_JWKS_URL=
SUPABASE_JWKS_CACHE_SECONDS=300
JWT_AUDIENCE=authenticated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hypofit.bukae.co.kr,https://hypofit.vercel.app
LOCAL_TMP_DIR=/tmp/hypofit
KAKAO_REST_API_KEY=replace_me
ADMIN_EMAILS=admin@example.com
PUSH_ENABLED=false
PUSH_WORKER_ENABLED=false
PUSH_WORKER_BATCH_SIZE=20
PUSH_WORKER_ACTIVE_SLEEP_SECONDS=2
PUSH_WORKER_IDLE_SLEEP_SECONDS=30
PUSH_WORKER_ERROR_SLEEP_SECONDS=30
PUSH_MAX_ATTEMPTS=3
PUSH_BATCH_SIZE=100
PUSH_SENDING_TIMEOUT_SECONDS=300
PUSH_APNS_ENABLED=false
PUSH_APNS_ENV=production
PUSH_APNS_TEAM_ID=replace_me
PUSH_APNS_KEY_ID=replace_me
PUSH_APNS_BUNDLE_ID=com.contentruck.hypofit
PUSH_APNS_PRIVATE_KEY_PATH=/path/to/AuthKey_KEYID.p8
PUSH_FCM_ENABLED=false
PUSH_FCM_PROJECT_ID=replace_me
PUSH_FCM_SERVICE_ACCOUNT_JSON_PATH=/path/to/firebase-service-account.json
AI_SUMMARY_ENABLED=false
AI_INTERVIEW_SUMMARY_ENABLED=false
AI_APPLICANT_SUMMARY_ENABLED=false
AI_SUMMARY_WORKER_ENABLED=false
AI_SUMMARY_PROVIDER=disabled
AI_SUMMARY_API_KEY=
AI_SUMMARY_API_BASE_URL=https://api.openai.com/v1
AI_SUMMARY_MODEL=
AI_SUMMARY_TIMEOUT_SECONDS=30
AI_SUMMARY_WORKER_BATCH_SIZE=5
AI_SUMMARY_WORKER_ACTIVE_SLEEP_SECONDS=2
AI_SUMMARY_WORKER_IDLE_SLEEP_SECONDS=20
AI_SUMMARY_WORKER_ERROR_SLEEP_SECONDS=30
AI_SUMMARY_PROCESSING_TIMEOUT_SECONDS=300
AI_SUMMARY_MAX_ATTEMPTS=3
