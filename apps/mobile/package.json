{
  "name": "@hypofit/mobile",
  "private": true,
  "version": "1.0.1",
  "description": "Hypofit Expo React Native application for iOS and Android",
  "license": "MIT",
  "homepage": "https://hypofit.bukae.co.kr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSamParkSoft/hypofit.git",
    "directory": "apps/mobile"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo start --dev-client --ios",
    "android": "expo start --dev-client --android",
    "build:ios:dev": "bash scripts/build-ios-development.sh",
    "build:android:dev": "EAS_BUILD_PROFILE=development EAS_PROFILE=development EAS_BUILD_PLATFORM=android expo prebuild --platform android --no-install --no-clean && EAS_BUILD_PROFILE=development EAS_PROFILE=development EAS_BUILD_PLATFORM=android expo run:android --no-bundler",
    "build:environment": "bash scripts/build-environment.sh",
    "eas": "bash scripts/eas-cli.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src app --max-warnings=0 && node scripts/check-architecture-boundaries.mjs",
    "lint:boundaries": "node scripts/check-architecture-boundaries.mjs",
    "test": "node --test scripts/*.node-test.mjs",
    "test:posting-creation": "node scripts/postingCreationPayload.node-test.mjs",
    "test:posting-drafts": "node --test scripts/postingDraftStorage.node-test.mjs",
    "test:posting-detail": "node scripts/postingDetailCta.node-test.mjs",
    "test:chat-unread-badge": "node scripts/chatUnreadBadge.node-test.mjs",
    "test:notifications": "node --test scripts/notificationPresentation.node-test.mjs",
    "test:floating-tab-bar": "node --test scripts/floatingTabBar.node-test.mjs",
    "test:important-notice": "node scripts/importantNotice.node-test.mjs",
    "build:ios:local": "bash scripts/eas-local-ios-build.sh",
    "build:android:local": "bash scripts/eas-local-android-build.sh"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/ui": "~57.0.20",
    "@expo/vector-icons": "^15.0.3",
    "@hypofit/contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.105.0",
    "@tanstack/react-query": "^5.56.0",
    "expo": "~57.0.24",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.19",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.0.0",
    "@react-native-community/cli-platform-android": "^20.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.64.0"
  }
}
