{
  "name": "@hypofit/web",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm run typecheck && vite build",
    "lint": "pnpm run lint:eslint && pnpm run lint:boundaries",
    "lint:eslint": "eslint src vite.config.ts scripts eslint.config.mjs --max-warnings=0",
    "lint:boundaries": "node ./scripts/check-architecture-boundaries.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "pnpm run build && node ./scripts/browser-smoke.mjs",
    "test:browser:auth": "node ./scripts/authenticated-browser-smoke.mjs",
    "brand:export": "node ./scripts/export-brand-assets.mjs",
    "bundle:report": "node ./scripts/check-bundle-budget.mjs --report",
    "bundle:check": "node ./scripts/check-bundle-budget.mjs --check"
  },
  "dependencies": {
    "@hypofit/contracts": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.56.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.4",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
